# Smart Minds Tuitions Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# Provide a MongoDB Atlas or local MongoDB connection string.
# If omitted or unavailable, the server automatically starts an in-memory MongoDB instance for development/testing.
MONGODB_URI=mongodb://localhost:27017/smart_minds_tuitions

# Security & Authentication
JWT_SECRET=smart_minds_tuitions_super_secure_jwt_secret_key_2026_educate
JWT_EXPIRES_IN=7d

# File Uploads Directory
UPLOAD_PATH=uploads

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173

# Initial Admin Pre-provisioned Credentials (Used by seed script if seeded)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@smartmindstuitions.com
ADMIN_PASSWORD=AdminPass@2026!
